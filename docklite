show_help() {
    echo ""
    echo -e "  ${BOLD}Usage:${NC} ./docklite [command]"
    echo ""
    echo -e "  ${BOLD}Commands:${NC}"
    echo -e "    ${GOLD}start-all${NC}     Start agent + GUI via PM2"
    echo -e "    ${GOLD}start-agent${NC}   Start agent only"
    echo -e "    ${GOLD}start-gui${NC}     Start GUI only"
    echo -e "    ${GOLD}stop${NC}          Stop all services"
    echo -e "    ${GOLD}stop-agent${NC}    Stop agent"
    echo -e "    ${GOLD}stop-gui${NC}      Stop GUI"
    echo -e "    ${GOLD}restart${NC}       Restart all services"
    echo -e "    ${GOLD}status${NC}        Show service status"
    echo -e "    ${GOLD}logs${NC}          View PM2 logs"
    echo -e "    ${GOLD}tui${NC}           Launch terminal UI"
    echo -e "    ${GOLD}setup${NC}         Run setup wizard"
    echo -e "    ${GOLD}upgrade${NC}       Apply a new install, keeping config (used by install.sh)"
    echo -e "    ${GOLD}repair${NC}        Check health and whether sites follow the /sites/<user>/<domain> layout"
    echo -e "    ${GOLD}help${NC}          Show this help"
    echo ""
    echo -e "  ${BOLD}Manage your server:${NC} containers, sites, ssl, nginx, dns, users, backups, server, doctor, access..."
    echo -e "    ${DIM}docklite doctor        check everything is healthy${NC}"
    echo -e "    ${DIM}docklite containers list${NC}"
    echo -e "    ${DIM}docklite docs          full guide (also for AI assistants)${NC}"
    echo ""
    echo -e "  ${DIM}Run without arguments for interactive menu.${NC}"
    echo ""
}

# ══════════════════════════════════════════════════════════════════════════════
# SECTION 11: Entry point
# ══════════════════════════════════════════════════════════════════════════════

main() {
    local original_dir="$PWD"
    cd "$SCRIPT_DIR"

    case "${1:-}" in
        start-all)
            load_config; generate_ecosystem; pm2_start_all
            ok "All services started"
            ;;
        start-agent)
            load_config; generate_ecosystem; pm2_start_agent
            ok "Agent started"
            ;;
        start-gui)
            load_config; generate_ecosystem; pm2_start_gui
            ok "GUI started"
            ;;
        stop|stop-all)
            load_config; pm2_stop_all
            ok "All services stopped"
            ;;
        stop-agent)
            load_config; pm2_stop "docklite-agent"
            ok "Agent stopped"
            ;;
        stop-gui)
            load_config; pm2_stop "docklite-gui"
            ok "GUI stopped"
            ;;
        restart)
            load_config; generate_ecosystem
            pm2_delete_all; pm2_start_all
            ok "All services restarted"
            ;;
        status)
            load_config; show_dashboard
            ;;
        logs)
            load_config
            sudo_pm2 logs "${2:---lines}" "${3:-50}" 2>/dev/null
            ;;
        tui)
            load_config; launch_tui
            ;;
        setup)
            run_wizard
            ;;
        upgrade)
            run_upgrade
            ;;
        repair)
            run_repair
            ;;
        help|--help|-h)
            show_help
            ;;
        "")
            if is_first_run; then
                run_wizard
            else
                load_config
                run_menu
            fi
            ;;
        *)
            # Anything that isn't a service command is an API command
            # (containers, sites, ssl, doctor, docs, ...): hand it to the CLI.
            if [[ -x "${SCRIPT_DIR}/bin/docklite-cli" ]]; then
                cd "$original_dir"
                exec "${SCRIPT_DIR}/bin/docklite-cli" "$@"
            fi
            echo -e "  ${RED}Unknown command:${NC} $1"
            show_help
            exit 1
            ;;
    esac
}

main "$@"
