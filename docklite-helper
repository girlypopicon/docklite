#!/usr/bin/env bash
# docklite-helper — the only command DockLite runs as root.
#
# Installed root-owned at /usr/local/sbin/docklite-helper and granted via
# /etc/sudoers.d/docklite. Every privileged action the agent or the launcher
# needs is a subcommand here with its arguments validated, instead of
# granting broad commands (tee, cat, nginx, openssl) whose arguments sudoers
# can't meaningfully restrict.
set -euo pipefail

SITES_AVAILABLE=/etc/nginx/sites-available
SITES_ENABLED=/etc/nginx/sites-enabled
LE_LIVE=/etc/letsencrypt/live
SITES_ROOT=/var/www/sites
SITES_TRASH="$SITES_ROOT/.trash"

die() { echo "docklite-helper: $*" >&2; exit 1; }

# nginx config file names: no slashes, no leading dot.
check_name() {
    [[ "${1:-}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,252}$ ]] || die "invalid config name: ${1:-}"
}

# Plain DNS hostname (same shape the agent accepts).
check_domain() {
    [[ ${#1} -le 253 && "$1" =~ ^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)+$ ]] \
        || die "invalid domain: $1"
}

# A person's login account on this server: a plain name, an existing user,
# a real (non-system) uid, a real shell, and never docklite itself. Group
# changes are refused for anything else — root, service accounts, nobody.
check_os_user() {
    local name="${1:-}" entry uid shell min
    [[ "$name" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || die "invalid username: ${name}"
    [[ "$name" != "docklite" && "$name" != "root" ]] || die "refusing to change the ${name} account"
    entry=$(getent passwd "$name") || die "no such user on this server: ${name}"
    uid=$(cut -d: -f3 <<<"$entry")
    shell=$(cut -d: -f7 <<<"$entry")
    min=$(awk '/^UID_MIN/{print $2}' /etc/login.defs 2>/dev/null || true)
    [[ "${uid}" =~ ^[0-9]+$ && "${uid}" -ge "${min:-1000}" && "${uid}" -lt 65534 ]] || die "refusing to change a system account: ${name}"
    [[ "$shell" != */nologin && "$shell" != */false && -n "$shell" ]] || die "${name} has no login shell, so shell access would do nothing"
}

check_email() {
    [[ "$1" =~ ^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$ ]] || die "invalid email: $1"
}

# A site folder relative to /var/www/sites: "<user>" or "<user>/<domain>", no hidden parts, no "..".
check_site_rel() {
    [[ "${1:-}" =~ ^[A-Za-z0-9_][A-Za-z0-9._-]{0,253}(/[A-Za-z0-9_][A-Za-z0-9._-]{0,253})?$ ]] || die "invalid site folder: ${1:-}"
}

# A trash entry name as the agent writes it: "<YYYYMMDD-HHMMSS>-<original path with / as __>".
check_trash_name() {
    [[ "${1:-}" =~ ^[0-9]{8}-[0-9]{6}-[A-Za-z0-9_][A-Za-z0-9._-]{0,509}$ ]] || die "invalid trash entry: ${1:-}"
}

# ── nginx upstream ports ────────────────────────────────────────────────────
# DockLite publishes each site on 127.0.0.1:<port>, and nginx's proxy_pass names that port. If the port ever differs
# from the container's real one the site shows 502. These two commands let the agent find and fix that, for
# every nginx file (sites-available, conf.d and old multi-site files), one `server { }` block at a time.

nginx_path_ok() {
    case "$1" in
        /etc/nginx/sites-available/*|/etc/nginx/conf.d/*|/etc/nginx/sites-enabled/*) return 0 ;;
    esac
    return 1
}

# One line per server block: FILE <TAB> server names <TAB> proxy_pass ports (local upstreams only) <TAB> "down" if the
# block already has the stopped-box page (or its own 502 page), "-" if not
nginx_upstream_scan() {
    awk -v FILE="$1" '
    function strip(s) { sub(/#.*/, "", s); return s }
    BEGIN { depth = 0; inserver = 0 }
    {
        line = strip($0)
        n_open = gsub(/\{/, "{", line); n_close = gsub(/\}/, "}", line)
        if (!inserver && match(line, /(^|[ \t;])server[ \t]*\{/)) { inserver = 1; sdepth = depth; names = ""; ports = ""; down = "-" }
        if (inserver) {
            if (line ~ /docklite-down/ || line ~ /error_page[ \t][^;]*502/) down = "down"
            if (match(line, /server_name[ \t]+[^;]+;/)) {
                t = substr(line, RSTART, RLENGTH); sub(/server_name[ \t]+/, "", t); sub(/;.*/, "", t); names = names " " t
            }
            rest = line
            while (match(rest, /proxy_pass[ \t]+https?:\/\/(127\.0\.0\.1|localhost):[0-9]+/)) {
                t = substr(rest, RSTART, RLENGTH); sub(/.*:/, "", t); ports = ports " " t
                rest = substr(rest, RSTART + RLENGTH)
            }
        }
        depth += n_open - n_close
        if (inserver && depth <= sdepth) { print FILE "\t" names "\t" ports "\t" down; inserver = 0 }
    }' "$1"
}

# Print the file with OLD replaced by NEW in the local proxy_pass lines of the server block(s) that name DOMAIN.
nginx_fix_port_stream() {
    awk -v DOM="$2" -v OLD="$3" -v NEW="$4" '
    function strip(s) { sub(/#.*/, "", s); return s }
    { lines[NR] = $0 }
    END {
        depth = 0; inserver = 0; want = tolower(DOM)
        for (i = 1; i <= NR; i++) {
            line = strip(lines[i])
            n_open = gsub(/\{/, "{", line); n_close = gsub(/\}/, "}", line)
            if (!inserver && match(line, /(^|[ \t;])server[ \t]*\{/)) { inserver = 1; sdepth = depth; bstart = i; names = "" }
            if (inserver && match(line, /server_name[ \t]+[^;]+;/)) {
                t = substr(line, RSTART, RLENGTH); sub(/server_name[ \t]+/, "", t); sub(/;.*/, "", t); names = names " " t
            }
            depth += n_open - n_close
            if (inserver && depth <= sdepth) {
                hit = 0; n = split(names, arr, " ")
                for (k = 1; k <= n; k++) { a = tolower(arr[k]); if (a == want || a == "www." want) hit = 1 }
                if (hit) {
                    for (j = bstart; j <= i; j++) {
                        if (match(lines[j], "proxy_pass[ \t]+https?://(127\\.0\\.0\\.1|localhost):" OLD)) {
                            nxt = substr(lines[j], RSTART + RLENGTH, 1)
                            if (nxt !~ /[0-9]/) {
                                pre = substr(lines[j], 1, RSTART - 1); m = substr(lines[j], RSTART, RLENGTH); post = substr(lines[j], RSTART + RLENGTH)
                                sub(/[0-9]+$/, NEW, m); lines[j] = pre m post
                            }
                        }
                    }
                }
                inserver = 0
            }
        }
        for (i = 1; i <= NR; i++) print lines[i]
    }' "$1"
}

# ── the "this box isn't running" page ────────────────────────────────────────
# A stopped box leaves its port closed and nginx answers 502. Every DockLite site's server block includes a snippet that
# swaps that for one branded page (sent as a 503). The page is written by `nginx-down-write`; `nginx-down-patch` adds
# the one include line to a site's server block. Visitors see the page, so it must never name anything about the server.
DOWN_PAGE=/var/lib/docklite/down.html
DOWN_SNIPPET=/etc/nginx/snippets/docklite-down.conf
# A wildcard include matches nothing, instead of failing `nginx -t`, while the snippet file doesn't exist.
DOWN_INCLUDE='include /etc/nginx/snippets/docklite-down*.conf;'

down_snippet_text() {
    cat <<'SNIP'
# Written by DockLite. When a site's box isn't running, nginx would show a plain "502 Bad Gateway"; this shows DockLite's
# page instead (as a 503, so search engines treat it as "back soon"). Edit the wording in DockLite: Settings.
error_page 502 =503 /__docklite_down;
location = /__docklite_down {
    internal;
    alias /var/lib/docklite/down.html;
    default_type text/html;
    add_header Retry-After 60 always;
    add_header Cache-Control "no-store" always;
    add_header X-Robots-Tag "noindex, nofollow" always;
}
SNIP
}

# Print the file with the include added after the server_name line of every server block that names DOMAIN, proxies to a
# local upstream and has neither the include nor a 502 page of its own. A server_name on a line that also holds braces is
# left alone (the include has to land inside the block).
nginx_down_patch_stream() {
    awk -v DOM="$2" -v INC="$DOWN_INCLUDE" '
    function strip(s) { sub(/#.*/, "", s); return s }
    { lines[NR] = $0 }
    END {
        depth = 0; inserver = 0; want = tolower(DOM)
        for (i = 1; i <= NR; i++) {
            line = strip(lines[i])
            n_open = gsub(/\{/, "{", line); n_close = gsub(/\}/, "}", line)
            if (!inserver && match(line, /(^|[ \t;])server[ \t]*\{/)) { inserver = 1; sdepth = depth; names = ""; snline = 0; proxy = 0; has = 0 }
            if (inserver) {
                if (match(line, /server_name[ \t]+[^;]+;/)) {
                    t = substr(line, RSTART, RLENGTH); sub(/server_name[ \t]+/, "", t); sub(/;.*/, "", t); names = names " " t
                    if (!snline && n_open == 0 && n_close == 0) snline = i
                }
                if (line ~ /proxy_pass[ \t]+https?:\/\/(127\.0\.0\.1|localhost):[0-9]+/) proxy = 1
                if (line ~ /docklite-down/ || line ~ /error_page[ \t][^;]*502/) has = 1
            }
            depth += n_open - n_close
            if (inserver && depth <= sdepth) {
                hit = 0; n = split(names, arr, " ")
                for (k = 1; k <= n; k++) { a = tolower(arr[k]); if (a == want || a == "www." want) hit = 1 }
                if (hit && proxy && !has && snline) ins[snline] = 1
                inserver = 0
            }
        }
        for (i = 1; i <= NR; i++) {
            print lines[i]
            if (ins[i]) { match(lines[i], /^[ \t]*/); print substr(lines[i], 1, RLENGTH) INC }
        }
    }' "$1"
}

# ── self-update ─────────────────────────────────────────────────────────────
# The dashboard's Update button calls `update-start vX.Y.Z`. Only a release tag of that exact shape is accepted;
# nothing else the caller sends ever reaches a shell. The work runs as its own systemd job so it survives
# DockLite restarting itself.
UPDATE_STATE=/var/lib/docklite/update-state
UPDATE_LOG=/var/log/docklite/update.log
UPDATE_SRC=/usr/local/src/docklite
UPDATE_REPO=https://github.com/girlypopicon/docklite.git
INSTALL_DIR=/opt/docklite

check_release_tag() {
    [[ "${1:-}" =~ ^v[0-9]{1,4}\.[0-9]{1,4}\.[0-9]{1,4}$ ]] || die "invalid release tag: ${1:-}"
}

# <state> <tag> [message]  (read back, without root, by the dashboard)
set_update_state() {
    mkdir -p /var/lib/docklite; chmod 755 /var/lib/docklite
    printf '%s %s %s %s\n' "$1" "$2" "$(date +%s)" "${3:-}" > "${UPDATE_STATE}.tmp"
    chmod 644 "${UPDATE_STATE}.tmp"
    mv -f "${UPDATE_STATE}.tmp" "$UPDATE_STATE"
}

# Make /opt/docklite usable by the docklite group again (the installer may run as root).
fix_install_perms() {
    local d="$INSTALL_DIR" f
    [[ -d "$d" ]] || return 0
    chown docklite:docklite "$d"
    chmod 775 "$d"
    for f in .docklite.conf ecosystem.config.js; do
        [[ -f "$d/$f" ]] && { chown docklite:docklite "$d/$f"; chmod 660 "$d/$f"; }
    done
    return 0
}

# Is DockLite answering? Any HTTP reply from the agent counts; the GUI must serve its login page.
docklite_healthy() {
    local port code
    port="$(grep -E '^AGENT_PORT=' "$INSTALL_DIR/.docklite.conf" 2>/dev/null | head -1 | cut -d= -f2 | tr -d "\"'")"
    [[ "$port" =~ ^[0-9]+$ ]] || return 1
    code="$(curl -s -o /dev/null -m 4 -w '%{http_code}' "http://127.0.0.1:${port}/api/health" 2>/dev/null || true)"
    [[ "$code" =~ ^[2-4][0-9][0-9]$ ]] || return 1
    code="$(curl -s -o /dev/null -m 4 -w '%{http_code}' "http://127.0.0.1:${port}/login" 2>/dev/null || true)"
    [[ "$code" == "200" ]]
}

wait_healthy() {
    local waited=0
    while (( waited < ${1:-150} )); do
        docklite_healthy && return 0
        sleep 5; waited=$((waited + 5))
    done
    return 1
}

# Turn the installer's terminal output into plain log lines (see install_release). Works on bytes (LC_ALL=C), so it
# behaves the same under every locale, and if the filter can't run for any reason the output is passed through as it is:
# a cosmetic step must never be able to stop an update.
CLEAN_SED='s/\x1b\[[0-9;?]*[A-Za-z]//g
s/\xe2[\xa0-\xa3][\x80-\xbf]//g
s/^[[:space:]]+//
s/[[:space:]]+$//
s/^.*\.\.\. (\xe2\x9c\x93)/\1/
/^$/d
/^(\xe2\x94[\x80\x81])+$/d
/^[_\/\\|<>(),. -]+$/d
/^Updating packages/d'
clean_installer_output() {
    if [[ "$(printf '\033[0;32m\xe2\xa0\x8bok\033[0m\n' | LC_ALL=C sed -u -E "$CLEAN_SED" 2>/dev/null)" == ok ]]; then
        LC_ALL=C tr '\r' '\n' | LC_ALL=C sed -u -E "$CLEAN_SED" | LC_ALL=C uniq
    else
        cat
    fi
}

# Check out exactly one release tag in the source copy and install it without asking questions.
install_release() {
    local tag="$1" want
    git -C "$UPDATE_SRC" fetch --quiet --depth 1 origin "refs/tags/${tag}:refs/tags/${tag}" || return 10
    git -C "$UPDATE_SRC" checkout --quiet --force "$tag" || return 11
    want="$(tr -d '[:space:]' < "$UPDATE_SRC/VERSION" 2>/dev/null || true)"
    [[ "v${want}" == "$tag" ]] || { echo "release ${tag} contains version '${want}', which doesn't match its name"; return 12; }
    # The installer draws colours and spinners for a terminal; in the update log they turn into noise. Keep one clean
    # line per step: no colour codes, spinner frames dropped, repeated lines collapsed, banner and rules removed.
    ( cd "$UPDATE_SRC" && NO_COLOR=1 bash install.sh --yes 2>&1 ) | clean_installer_output
    local irc=${PIPESTATUS[0]}
    [[ $irc -eq 0 ]] || return 13   # the installer's own result, not the filter's
    fix_install_perms
    return 0
}

# Put the settings and data back exactly as the pre-update backup had them. Used when an update fails, so the old
# version never meets a database the new version already changed. Stops DockLite first so nothing is mid-write.
restore_data() {
    local backup="$1"
    [[ -f "$backup" ]] || return 1
    command -v pm2 >/dev/null 2>&1 && pm2 stop docklite-agent docklite-gui >/dev/null 2>&1 || true
    rm -f "$INSTALL_DIR/data/docklite.db-wal" "$INSTALL_DIR/data/docklite.db-shm"   # leftovers of the failed version
    tar xzf "$backup" -C "$INSTALL_DIR" data .docklite.conf || return 1
    fix_install_perms
}

run_update_job() {
    # Globals on purpose: the EXIT trap reads them after the function has unwound.
    tag="$1"; UPD_TAG="$1"; UPD_DONE=0
    local prev prev_tag backup rc=0
    export TERM=dumb
    [[ -n "${HOME:-}" ]] || export HOME=/root   # systemd-run starts jobs without one
    exec >>"$UPDATE_LOG" 2>&1
    ulog() { echo "[$(date '+%H:%M:%S')] $*"; }
    finish() { UPD_DONE=1; set_update_state "$1" "$UPD_TAG" "${2:-}"; }
    trap 'code=$?; if [[ $UPD_DONE -eq 0 && $code -ne 0 ]]; then set_update_state failed "$UPD_TAG" "stopped unexpectedly (exit $code); see the update log"; fi; [[ -n "${DOCKLITE_UPDATE_COPY:-}" ]] && rm -f "$DOCKLITE_UPDATE_COPY"' EXIT

    mkdir -p /var/lock
    exec 9>/var/lock/docklite-update.lock
    flock -n 9 || { ulog "Another update is already running."; finish failed "another update is already running"; exit 1; }

    prev="$(tr -d '[:space:]' < "$INSTALL_DIR/VERSION" 2>/dev/null || echo unknown)"
    prev_tag="v${prev}"
    ulog "Updating DockLite ${prev} -> ${tag#v}"

    command -v git >/dev/null 2>&1 || { ulog "git is not installed."; finish failed "git is not installed"; exit 1; }
    if [[ -d "$UPDATE_SRC/.git" ]]; then
        git -C "$UPDATE_SRC" remote set-url origin "$UPDATE_REPO"
    else
        mkdir -p "$(dirname "$UPDATE_SRC")"; git init -q "$UPDATE_SRC"; git -C "$UPDATE_SRC" remote add origin "$UPDATE_REPO"
    fi

    # Safety copy of the settings and data (small), before anything changes. Keep the last five.
    mkdir -p /var/backups/docklite
    backup="/var/backups/docklite/pre-update-${prev}-to-${tag#v}-$(date +%Y%m%d-%H%M%S).tgz"
    if tar czf "$backup" -C "$INSTALL_DIR" data .docklite.conf 2>/dev/null; then
        chmod 600 "$backup"; ulog "Backed up your data to $backup"
        ls -1t /var/backups/docklite/pre-update-*.tgz 2>/dev/null | tail -n +6 | xargs -r rm -f
    else
        ulog "Could not make the safety backup; stopping before changing anything."
        finish failed "could not back up your data first, so nothing was changed"; exit 1
    fi

    ulog "Downloading and installing ${tag} (building takes a few minutes)..."
    if install_release "$tag"; then rc=0; else rc=$?; fi
    if [[ $rc -eq 0 ]] && wait_healthy 150; then
        ulog "DockLite ${tag#v} is up and answering. Update complete."
        finish success "now running ${tag#v}"; exit 0
    fi

    # Something went wrong. Put the previous release back if we can.
    if [[ $rc -eq 10 || $rc -eq 11 ]]; then
        ulog "Could not download ${tag} (rc=$rc). Nothing was installed."
        finish failed "could not download ${tag} from GitHub; nothing was changed"; exit 1
    fi
    ulog "The new version didn't come up cleanly (step result $rc). Trying to restore ${prev_tag}..."
    if restore_data "$backup"; then ulog "Restored your data from the safety backup."; else ulog "Could not restore your data from the backup automatically."; fi
    if [[ "$prev" != unknown ]] && install_release "$prev_tag" && wait_healthy 150; then
        ulog "Restored ${prev}. Your data backup is at $backup"
        finish rolled-back "update to ${tag#v} failed; went back to ${prev}"; exit 1
    fi
    ulog "Could not restore automatically. Your data backup is at $backup"
    finish failed "update to ${tag#v} failed and automatic restore did not work; data backup: $backup"
    exit 1
}

cmd="${1:-}"
shift || true

case "$cmd" in
    site-write)       # site-write NAME  (config on stdin)
        check_name "${1:-}"
        tmp=$(mktemp "${SITES_AVAILABLE}/.docklite.XXXXXX")
        cat > "$tmp"
        chmod 644 "$tmp"
        # Keep the previous version (the newest 5 per site) so a bad write can be undone by hand. The backups live in
        # a folder nginx never includes.
        if [[ -f "${SITES_AVAILABLE}/$1" ]]; then
            bdir="${SITES_AVAILABLE}/.docklite-backups"
            mkdir -p "$bdir"
            cp -p "${SITES_AVAILABLE}/$1" "${bdir}/$1.$(date +%Y%m%d-%H%M%S)" 2>/dev/null || true
            ls -1t "${bdir}/$1".* 2>/dev/null | tail -n +6 | xargs -r rm -f
        fi
        mv -f "$tmp" "${SITES_AVAILABLE}/$1"
        ;;
    site-enable)      # site-enable NAME
        check_name "${1:-}"
        [[ -f "${SITES_AVAILABLE}/$1" ]] || die "no such site config: $1"
        ln -sfn "${SITES_AVAILABLE}/$1" "${SITES_ENABLED}/$1"
        ;;
    site-disable)     # site-disable NAME  (removes only the sites-enabled link)
        check_name "${1:-}"
        rm -f "${SITES_ENABLED}/$1"
        ;;
    site-remove)      # site-remove NAME   (removes enabled link and config)
        check_name "${1:-}"
        rm -f "${SITES_ENABLED}/$1" "${SITES_AVAILABLE}/$1"
        ;;
    site-trash)       # site-trash REL NAME   (move /var/www/sites/REL into the trash as NAME; for folders the
                      # docklite user can't move itself, e.g. root-owned ones from an older install)
        check_site_rel "${1:-}"; check_trash_name "${2:-}"
        src="$SITES_ROOT/$1"
        [[ -d "$src" && ! -L "$src" ]] || die "no such site folder: $1"
        mkdir -p "$SITES_TRASH"
        chown docklite:docklite "$SITES_TRASH"; chmod 2775 "$SITES_TRASH"
        [[ ! -e "$SITES_TRASH/$2" ]] || die "already in the trash: $2"
        mv "$src" "$SITES_TRASH/$2"
        # Hand it to the docklite user so the agent can empty the trash later without asking again.
        chown -R docklite:docklite "$SITES_TRASH/$2" 2>/dev/null || true
        ;;
    site-purge)       # site-purge NAME   (delete one trash entry for good)
        check_trash_name "${1:-}"
        t="$SITES_TRASH/$1"
        [[ -d "$t" && ! -L "$t" ]] || die "not in the trash: $1"
        rm -rf --one-file-system "$t"
        ;;
    nginx-survey)     # nginx-survey   (read-only: what nginx already serves)
        # Lines: "enabled NAME", "default_server NAME" (declares default_server),
        # and "stock_default yes|no" (is sites-enabled/default the untouched Debian page?).
        shopt -s nullglob
        for f in "${SITES_ENABLED}"/* /etc/nginx/conf.d/*.conf; do
            n=$(basename "$f")
            echo "enabled $n"
            grep -qE 'listen[^;]*default_server' "$f" 2>/dev/null && echo "default_server $n"
        done
        if [[ -e "${SITES_ENABLED}/default" ]] && grep -q 'root /var/www/html' "${SITES_ENABLED}/default" 2>/dev/null \
            && ! grep -q 'proxy_pass' "${SITES_ENABLED}/default" 2>/dev/null; then
            echo "stock_default yes"
        else
            echo "stock_default no"
        fi
        ;;
    nginx-upstreams)  # nginx-upstreams   (read-only: every server block's names and local proxy ports)
        shopt -s nullglob
        declare -A _seen=()
        for f in /etc/nginx/sites-enabled/* /etc/nginx/conf.d/*.conf; do
            r="$(readlink -f "$f" 2>/dev/null || true)"
            [[ -n "$r" && -f "$r" ]] || continue
            nginx_path_ok "$r" || continue
            [[ -n "${_seen[$r]:-}" ]] && continue
            _seen[$r]=1
            nginx_upstream_scan "$r"
        done
        ;;
    nginx-fix-port)   # nginx-fix-port FILE DOMAIN OLDPORT NEWPORT
        file="$(readlink -f "${1:-/nonexistent}" 2>/dev/null || true)"
        nginx_path_ok "$file" && [[ -f "$file" ]] || die "not an nginx config file: ${1:-}"
        check_domain "${2:-}"
        [[ "${3:-}" =~ ^[0-9]{1,5}$ && "${4:-}" =~ ^[0-9]{1,5}$ ]] || die "ports must be numbers"
        (( ${3} >= 1 && ${3} <= 65535 && ${4} >= 1024 && ${4} <= 65535 )) || die "port out of range"
        tmp="$(mktemp "${file}.docklite-tmp.XXXXXX")"
        nginx_fix_port_stream "$file" "$2" "$3" "$4" > "$tmp"
        if cmp -s "$file" "$tmp"; then rm -f "$tmp"; die "nothing to change in $(basename "$file") for $2"; fi
        mkdir -p /var/backups/docklite
        bak="/var/backups/docklite/nginx-$(basename "$file")-$(date +%Y%m%d-%H%M%S).bak"
        cp -p "$file" "$bak"
        chmod --reference="$file" "$tmp"; chown --reference="$file" "$tmp"
        mv -f "$tmp" "$file"
        if nginx -t >/dev/null 2>&1; then
            nginx -s reload
            ls -1t /var/backups/docklite/nginx-*.bak 2>/dev/null | tail -n +41 | xargs -r rm -f
            echo "ok: $2 port $3 -> $4 in $(basename "$file")"
        else
            cp -p "$bak" "$file"
            die "nginx rejected the change, so it was undone"
        fi
        ;;
    nginx-down-write) # nginx-down-write   (the page's HTML on stdin; also installs the nginx snippet that serves it)
        mkdir -p /var/lib/docklite /etc/nginx/snippets; chmod 755 /var/lib/docklite
        tmp="$(mktemp /var/lib/docklite/down.html.XXXXXX)"
        head -c 65537 > "$tmp"
        size="$(stat -c %s "$tmp")"
        if (( size < 1 || size > 65536 )); then rm -f "$tmp"; die "the page is empty or over 64 KB"; fi
        chmod 644 "$tmp"; mv -f "$tmp" "$DOWN_PAGE"
        snip="$(mktemp)"; down_snippet_text > "$snip"
        if ! cmp -s "$snip" "$DOWN_SNIPPET"; then
            prev=""
            [[ -f "$DOWN_SNIPPET" ]] && { prev="$(mktemp)"; cp -p "$DOWN_SNIPPET" "$prev"; }
            install -m 644 "$snip" "$DOWN_SNIPPET"
            if nginx -t >/dev/null 2>&1; then
                nginx -s reload
            else
                if [[ -n "$prev" ]]; then cp -p "$prev" "$DOWN_SNIPPET"; else rm -f "$DOWN_SNIPPET"; fi
                rm -f "$snip" "$prev"
                die "nginx rejected the stopped-box snippet, so it was undone"
            fi
            [[ -n "$prev" ]] && rm -f "$prev"
        fi
        rm -f "$snip"
        echo "ok: stopped-box page written"
        ;;
    maintenance-write) # maintenance-write   (the "back soon" page's HTML on stdin; installs the nginx snippet that serves it)
        # Every site already includes docklite-down*.conf, so a second snippet with that prefix is picked up with no
        # change to any site's file. It answers 503 for a site while a flag file named after it exists.
        mkdir -p /var/lib/docklite/maintenance /etc/nginx/snippets; chmod 755 /var/lib/docklite /var/lib/docklite/maintenance
        tmp="$(mktemp /var/lib/docklite/maintenance.html.XXXXXX)"
        head -c 65537 > "$tmp"
        size="$(stat -c %s "$tmp")"
        if (( size < 1 || size > 65536 )); then rm -f "$tmp"; die "the page is empty or over 64 KB"; fi
        chmod 644 "$tmp"; mv -f "$tmp" /var/lib/docklite/maintenance.html
        snip="$(mktemp)"
        cat > "$snip" <<'SNIP'
# Written by DockLite. While a flag file named after a site (or ALL) exists in /var/lib/docklite/maintenance, visitors get
# the "back soon" page as a 503. Turning it on or off only creates or removes a file, so nothing reloads.
set $docklite_maint "";
if (-f /var/lib/docklite/maintenance/ALL) { set $docklite_maint 1; }
if (-f /var/lib/docklite/maintenance/$host) { set $docklite_maint 1; }
if ($uri = /__docklite_maint) { set $docklite_maint ""; }
if ($docklite_maint) { return 503; }
error_page 503 /__docklite_maint;
location = /__docklite_maint {
    internal;
    alias /var/lib/docklite/maintenance.html;
    default_type text/html;
    add_header Retry-After 3600 always;
    add_header Cache-Control "no-store" always;
    add_header X-Robots-Tag "noindex, nofollow" always;
}
SNIP
        target=/etc/nginx/snippets/docklite-down-maintenance.conf
        if ! cmp -s "$snip" "$target"; then
            prev=""
            [[ -f "$target" ]] && { prev="$(mktemp)"; cp -p "$target" "$prev"; }
            install -m 644 "$snip" "$target"
            if nginx -t >/dev/null 2>&1; then
                nginx -s reload
            else
                if [[ -n "$prev" ]]; then cp -p "$prev" "$target"; else rm -f "$target"; fi
                rm -f "$snip" "$prev"
                die "nginx rejected the back-soon snippet, so it was undone"
            fi
            [[ -n "$prev" ]] && rm -f "$prev"
        fi
        rm -f "$snip"
        echo "ok: back-soon page written"
        ;;
    maintenance-set)  # maintenance-set DOMAIN|ALL on|off
        name="${1:-}"; mode="${2:-}"
        if [[ "$name" != "ALL" ]]; then check_domain "$name"; fi
        mkdir -p /var/lib/docklite/maintenance
        case "$mode" in
            on)  : > "/var/lib/docklite/maintenance/$name"; chmod 644 "/var/lib/docklite/maintenance/$name" ;;
            off) rm -f "/var/lib/docklite/maintenance/$name" ;;
            *)   die "usage: maintenance-set DOMAIN|ALL on|off" ;;
        esac
        ;;
    maintenance-list) # maintenance-list   (names with back-soon mode on, one per line)
        ls -1 /var/lib/docklite/maintenance 2>/dev/null || true
        ;;
    nginx-down-patch) # nginx-down-patch FILE DOMAIN   (adds the include to that site's server block(s))
        file="$(readlink -f "${1:-/nonexistent}" 2>/dev/null || true)"
        nginx_path_ok "$file" && [[ -f "$file" ]] || die "not an nginx config file: ${1:-}"
        check_domain "${2:-}"
        tmp="$(mktemp "${file}.docklite-tmp.XXXXXX")"
        nginx_down_patch_stream "$file" "$2" > "$tmp"
        if cmp -s "$file" "$tmp"; then rm -f "$tmp"; die "nothing to change in $(basename "$file") for $2"; fi
        mkdir -p /var/backups/docklite
        bak="/var/backups/docklite/nginx-$(basename "$file")-$(date +%Y%m%d-%H%M%S).bak"
        cp -p "$file" "$bak"
        chmod --reference="$file" "$tmp"; chown --reference="$file" "$tmp"
        mv -f "$tmp" "$file"
        if nginx -t >/dev/null 2>&1; then
            nginx -s reload
            ls -1t /var/backups/docklite/nginx-*.bak 2>/dev/null | tail -n +41 | xargs -r rm -f
            echo "ok: stopped-box page added for $2 in $(basename "$file")"
        else
            cp -p "$bak" "$file"
            die "nginx rejected the change, so it was undone"
        fi
        ;;
    update-start)     # update-start vX.Y.Z   (runs the update as a detached systemd job)
        check_release_tag "${1:-}"
        mkdir -p /var/log/docklite /var/lib/docklite; chmod 755 /var/log/docklite /var/lib/docklite
        if [[ -f "$UPDATE_STATE" ]]; then
            read -r st _t at _rest < "$UPDATE_STATE" || true
            # "running" counts only while the job really is: its lock is held, or it only just started. A job that was
            # killed leaves "running" behind, and that must not block the next try.
            if [[ "${st:-}" == running && "${at:-0}" =~ ^[0-9]+$ ]] && (( $(date +%s) - at < 2700 )); then
                age=$(( $(date +%s) - at ))
                if (( age < 30 )) || ! flock -n /var/lock/docklite-update.lock true 2>/dev/null; then
                    die "an update is already running"
                fi
            fi
        fi
        set_update_state running "$1" "starting"
        : > "$UPDATE_LOG"; chmod 644 "$UPDATE_LOG"
        if command -v systemd-run >/dev/null 2>&1; then
            systemd-run --quiet --no-block --collect --unit "docklite-update-$(date +%s)" --setenv=TERM=dumb \
                /usr/local/sbin/docklite-helper update-job "$1" || die "could not start the update job"
        else
            TERM=dumb setsid nohup /usr/local/sbin/docklite-helper update-job "$1" >/dev/null 2>&1 </dev/null &
        fi
        ;;
    update-job)       # update-job vX.Y.Z   (internal: the detached worker; same validation)
        check_release_tag "${1:-}"
        # The install step replaces this very script. Run from a private copy so that can't disturb us.
        if [[ -z "${DOCKLITE_UPDATE_COPY:-}" ]]; then
            copy="$(mktemp /tmp/docklite-update-job.XXXXXX)"
            cp "$0" "$copy"
            DOCKLITE_UPDATE_COPY="$copy" exec bash "$copy" update-job "$1"
        fi
        run_update_job "$1"
        ;;
    fix-install-perms) # fix-install-perms   (make /opt/docklite usable by the docklite group again)
        [[ -d "$INSTALL_DIR" ]] || die "no DockLite install at $INSTALL_DIR"
        fix_install_perms
        ;;
    group-list)       # group-list   (members of the docklite group, one per line)
        getent group docklite | cut -d: -f4 | tr ',' '\n' | sed '/^$/d'
        ;;
    group-add)        # group-add USER   (admin shell access to DockLite)
        check_os_user "${1:-}"
        usermod -aG docklite "$1"
        ;;
    group-remove)     # group-remove USER
        check_os_user "${1:-}"
        gpasswd -d "$1" docklite
        ;;
    nginx-test)
        nginx -t
        ;;
    nginx-reload)
        nginx -t && nginx -s reload
        ;;
    nginx-restart)
        systemctl restart nginx
        ;;
    cert-issue)       # cert-issue DOMAIN [--www] [--email ADDRESS]
        domain="${1:-}"; shift || true
        check_domain "$domain"
        args=(--nginx -d "$domain" --non-interactive --agree-tos)
        email=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --www)   args+=(-d "www.${domain}"); shift ;;
                --email) check_email "${2:-}"; email="$2"; shift 2 ;;
                *)       die "unknown option: $1" ;;
            esac
        done
        if [[ -n "$email" ]]; then
            args+=(--email "$email")
        else
            args+=(--register-unsafely-without-email)
        fi
        certbot "${args[@]}"
        ;;
    cert-obtain)      # cert-obtain DOMAIN [--email ADDRESS]
        # Get a certificate without letting certbot edit nginx configs, so
        # DockLite can keep writing its own (certbot's edits would be lost
        # the next time DockLite rewrites the file). Renewals reload nginx.
        domain="${1:-}"; shift || true
        check_domain "$domain"
        args=(certonly --nginx -d "$domain" --non-interactive --agree-tos
              --keep-until-expiring --deploy-hook "systemctl reload nginx")
        email=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --email) check_email "${2:-}"; email="$2"; shift 2 ;;
                *)       die "unknown option: $1" ;;
            esac
        done
        if [[ -n "$email" ]]; then
            args+=(--email "$email")
        else
            args+=(--register-unsafely-without-email)
        fi
        certbot "${args[@]}"
        ;;
    cert-exists)      # cert-exists DOMAIN   (exit 0 if a certificate is installed)
        check_domain "${1:-}"
        [[ -f "${LE_LIVE}/$1/fullchain.pem" ]]
        ;;
    origin-cert-write)  # origin-cert-write DOMAIN   (certificate PEM, then private key PEM, on stdin)
        check_domain "${1:-}"
        d="/etc/ssl/cloudflare/$1"
        pem=$(cat)
        cert=$(printf '%s\n' "$pem" | awk '/-----BEGIN CERTIFICATE-----/{p=1} p{print} /-----END CERTIFICATE-----/{p=0}')
        key=$(printf '%s\n' "$pem" | awk '/-----BEGIN [A-Z ]*PRIVATE KEY-----/{p=1} p{print} /-----END [A-Z ]*PRIVATE KEY-----/{p=0}')
        [[ -n "$cert" && -n "$key" ]] || die "need a certificate and a private key on stdin"
        mkdir -p "$d"; chmod 755 /etc/ssl/cloudflare "$d"
        umask 077
        printf '%s\n' "$key" > "$d/privkey.pem.new"; chmod 600 "$d/privkey.pem.new"
        printf '%s\n' "$cert" > "$d/fullchain.pem.new"; chmod 644 "$d/fullchain.pem.new"
        mv -f "$d/privkey.pem.new" "$d/privkey.pem"; mv -f "$d/fullchain.pem.new" "$d/fullchain.pem"
        ;;
    origin-cert-exists)  # origin-cert-exists DOMAIN   (exit 0 if a Cloudflare origin certificate is installed)
        check_domain "${1:-}"
        [[ -f "/etc/ssl/cloudflare/$1/fullchain.pem" && -f "/etc/ssl/cloudflare/$1/privkey.pem" ]]
        ;;
    cert-renewal-exists)  # cert-renewal-exists NAME   (exit 0 if certbot can renew this certificate)
        check_name "${1:-}"
        [[ -f "/etc/letsencrypt/renewal/$1.conf" ]]
        ;;
    cert-renew)       # cert-renew DOMAIN
        check_domain "${1:-}"
        certbot renew --cert-name "$1" --force-renewal
        ;;
    cert-delete)      # cert-delete DOMAIN
        check_domain "${1:-}"
        certbot delete --cert-name "$1" --non-interactive
        ;;
    cert-list)
        ls "$LE_LIVE"
        ;;
    cert-read)        # cert-read NAME   (public certificate only, never the key)
        check_name "${1:-}"
        cat "${LE_LIVE}/$1/cert.pem"
        ;;
    *)
        die "usage: docklite-helper {site-write|site-enable|site-disable|site-remove|site-trash|site-purge|nginx-test|nginx-reload|nginx-restart|nginx-upstreams|nginx-fix-port|nginx-down-write|maintenance-write|maintenance-set|maintenance-list|nginx-down-patch|cert-issue|cert-obtain|cert-exists|origin-cert-write|origin-cert-exists|cert-renewal-exists|cert-renew|cert-delete|cert-list|cert-read} ..."
        ;;
esac
