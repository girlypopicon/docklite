#!/usr/bin/env bash
# docklite-helper — the only command DockLite runs as root.
#
# Installed root-owned at /usr/local/sbin/docklite-helper and granted via
# /etc/sudoers.d/docklite. Every privileged action the agent or the launcher
# needs is a subcommand here with its arguments validated, instead of
# granting broad commands (tee, cat, nginx, openssl) whose arguments sudoers
# can't meaningfully restrict.
set -euo pipefail

SITES_AVAILABLE=/etc/nginx/sites-available
SITES_ENABLED=/etc/nginx/sites-enabled
LE_LIVE=/etc/letsencrypt/live

die() { echo "docklite-helper: $*" >&2; exit 1; }

# nginx config file names: no slashes, no leading dot.
check_name() {
    [[ "${1:-}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,252}$ ]] || die "invalid config name: ${1:-}"
}

# Plain DNS hostname (same shape the agent accepts).
check_domain() {
    [[ ${#1} -le 253 && "$1" =~ ^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)+$ ]] \
        || die "invalid domain: $1"
}

# A person's login account on this server: a plain name, an existing user,
# a real (non-system) uid, a real shell, and never docklite itself. Group
# changes are refused for anything else — root, service accounts, nobody.
check_os_user() {
    local name="${1:-}" entry uid shell min
    [[ "$name" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || die "invalid username: ${name}"
    [[ "$name" != "docklite" && "$name" != "root" ]] || die "refusing to change the ${name} account"
    entry=$(getent passwd "$name") || die "no such user on this server: ${name}"
    uid=$(cut -d: -f3 <<<"$entry")
    shell=$(cut -d: -f7 <<<"$entry")
    min=$(awk '/^UID_MIN/{print $2}' /etc/login.defs 2>/dev/null || true)
    [[ "${uid}" =~ ^[0-9]+$ && "${uid}" -ge "${min:-1000}" && "${uid}" -lt 65534 ]] || die "refusing to change a system account: ${name}"
    [[ "$shell" != */nologin && "$shell" != */false && -n "$shell" ]] || die "${name} has no login shell, so shell access would do nothing"
}

check_email() {
    [[ "$1" =~ ^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$ ]] || die "invalid email: $1"
}

# ── self-update ─────────────────────────────────────────────────────────────
# The dashboard's Update button calls `update-start vX.Y.Z`. Only a release tag of that exact shape is accepted;
# nothing else the caller sends ever reaches a shell. The work runs as its own systemd job so it survives
# DockLite restarting itself.
UPDATE_STATE=/var/lib/docklite/update-state
UPDATE_LOG=/var/log/docklite/update.log
UPDATE_SRC=/usr/local/src/docklite
UPDATE_REPO=https://github.com/girlypopicon/docklite.git
INSTALL_DIR=/opt/docklite

check_release_tag() {
    [[ "${1:-}" =~ ^v[0-9]{1,4}\.[0-9]{1,4}\.[0-9]{1,4}$ ]] || die "invalid release tag: ${1:-}"
}

# <state> <tag> [message]  (read back, without root, by the dashboard)
set_update_state() {
    mkdir -p /var/lib/docklite; chmod 755 /var/lib/docklite
    printf '%s %s %s %s\n' "$1" "$2" "$(date +%s)" "${3:-}" > "${UPDATE_STATE}.tmp"
    chmod 644 "${UPDATE_STATE}.tmp"
    mv -f "${UPDATE_STATE}.tmp" "$UPDATE_STATE"
}

# Make /opt/docklite usable by the docklite group again (the installer may run as root).
fix_install_perms() {
    local d="$INSTALL_DIR" f
    [[ -d "$d" ]] || return 0
    chown docklite:docklite "$d"
    chmod 775 "$d"
    for f in .docklite.conf ecosystem.config.js; do
        [[ -f "$d/$f" ]] && { chown docklite:docklite "$d/$f"; chmod 660 "$d/$f"; }
    done
    return 0
}

# Is DockLite answering? Any HTTP reply from the agent counts; the GUI must serve its login page.
docklite_healthy() {
    local port code
    port="$(grep -E '^AGENT_PORT=' "$INSTALL_DIR/.docklite.conf" 2>/dev/null | head -1 | cut -d= -f2 | tr -d "\"'")"
    [[ "$port" =~ ^[0-9]+$ ]] || return 1
    code="$(curl -s -o /dev/null -m 4 -w '%{http_code}' "http://127.0.0.1:${port}/api/health" 2>/dev/null || true)"
    [[ "$code" =~ ^[2-4][0-9][0-9]$ ]] || return 1
    code="$(curl -s -o /dev/null -m 4 -w '%{http_code}' "http://127.0.0.1:${port}/login" 2>/dev/null || true)"
    [[ "$code" == "200" ]]
}

wait_healthy() {
    local waited=0
    while (( waited < ${1:-150} )); do
        docklite_healthy && return 0
        sleep 5; waited=$((waited + 5))
    done
    return 1
}

# Check out exactly one release tag in the source copy and install it without asking questions.
install_release() {
    local tag="$1" want
    git -C "$UPDATE_SRC" fetch --quiet --depth 1 origin "refs/tags/${tag}:refs/tags/${tag}" || return 10
    git -C "$UPDATE_SRC" checkout --quiet --force "$tag" || return 11
    want="$(tr -d '[:space:]' < "$UPDATE_SRC/VERSION" 2>/dev/null || true)"
    [[ "v${want}" == "$tag" ]] || { echo "release ${tag} contains version '${want}', which doesn't match its name"; return 12; }
    ( cd "$UPDATE_SRC" && bash install.sh --yes ) || return 13
    fix_install_perms
    return 0
}

run_update_job() {
    # Globals on purpose: the EXIT trap reads them after the function has unwound.
    tag="$1"; UPD_TAG="$1"; UPD_DONE=0
    local prev prev_tag backup rc=0
    export TERM=dumb
    exec >>"$UPDATE_LOG" 2>&1
    ulog() { echo "[$(date '+%H:%M:%S')] $*"; }
    finish() { UPD_DONE=1; set_update_state "$1" "$UPD_TAG" "${2:-}"; }
    trap 'code=$?; if [[ $UPD_DONE -eq 0 && $code -ne 0 ]]; then set_update_state failed "$UPD_TAG" "stopped unexpectedly (exit $code); see the update log"; fi; [[ -n "${DOCKLITE_UPDATE_COPY:-}" ]] && rm -f "$DOCKLITE_UPDATE_COPY"' EXIT

    mkdir -p /var/lock
    exec 9>/var/lock/docklite-update.lock
    flock -n 9 || { ulog "Another update is already running."; finish failed "another update is already running"; exit 1; }

    prev="$(tr -d '[:space:]' < "$INSTALL_DIR/VERSION" 2>/dev/null || echo unknown)"
    prev_tag="v${prev}"
    ulog "Updating DockLite ${prev} -> ${tag#v}"

    command -v git >/dev/null 2>&1 || { ulog "git is not installed."; finish failed "git is not installed"; exit 1; }
    if [[ -d "$UPDATE_SRC/.git" ]]; then
        git -C "$UPDATE_SRC" remote set-url origin "$UPDATE_REPO"
    else
        mkdir -p "$(dirname "$UPDATE_SRC")"; git init -q "$UPDATE_SRC"; git -C "$UPDATE_SRC" remote add origin "$UPDATE_REPO"
    fi

    # Safety copy of the settings and data (small), before anything changes. Keep the last five.
    mkdir -p /var/backups/docklite
    backup="/var/backups/docklite/pre-update-${prev}-to-${tag#v}-$(date +%Y%m%d-%H%M%S).tgz"
    if tar czf "$backup" -C "$INSTALL_DIR" data .docklite.conf 2>/dev/null; then
        chmod 600 "$backup"; ulog "Backed up your data to $backup"
        ls -1t /var/backups/docklite/pre-update-*.tgz 2>/dev/null | tail -n +6 | xargs -r rm -f
    else
        ulog "Could not make the safety backup; stopping before changing anything."
        finish failed "could not back up your data first, so nothing was changed"; exit 1
    fi

    ulog "Downloading and installing ${tag} (building takes a few minutes)..."
    if install_release "$tag"; then rc=0; else rc=$?; fi
    if [[ $rc -eq 0 ]] && wait_healthy 150; then
        ulog "DockLite ${tag#v} is up and answering. Update complete."
        finish success "now running ${tag#v}"; exit 0
    fi

    # Something went wrong. Put the previous release back if we can.
    if [[ $rc -eq 10 || $rc -eq 11 ]]; then
        ulog "Could not download ${tag} (rc=$rc). Nothing was installed."
        finish failed "could not download ${tag} from GitHub; nothing was changed"; exit 1
    fi
    ulog "The new version didn't come up cleanly (step result $rc). Trying to restore ${prev_tag}..."
    if [[ "$prev" != unknown ]] && install_release "$prev_tag" && wait_healthy 150; then
        ulog "Restored ${prev}. Your data backup is at $backup"
        finish rolled-back "update to ${tag#v} failed; went back to ${prev}"; exit 1
    fi
    ulog "Could not restore automatically. Your data backup is at $backup"
    finish failed "update to ${tag#v} failed and automatic restore did not work; data backup: $backup"
    exit 1
}

cmd="${1:-}"
shift || true

case "$cmd" in
    site-write)       # site-write NAME  (config on stdin)
        check_name "${1:-}"
        tmp=$(mktemp "${SITES_AVAILABLE}/.docklite.XXXXXX")
        cat > "$tmp"
        chmod 644 "$tmp"
        mv -f "$tmp" "${SITES_AVAILABLE}/$1"
        ;;
    site-enable)      # site-enable NAME
        check_name "${1:-}"
        [[ -f "${SITES_AVAILABLE}/$1" ]] || die "no such site config: $1"
        ln -sfn "${SITES_AVAILABLE}/$1" "${SITES_ENABLED}/$1"
        ;;
    site-disable)     # site-disable NAME  (removes only the sites-enabled link)
        check_name "${1:-}"
        rm -f "${SITES_ENABLED}/$1"
        ;;
    site-remove)      # site-remove NAME   (removes enabled link and config)
        check_name "${1:-}"
        rm -f "${SITES_ENABLED}/$1" "${SITES_AVAILABLE}/$1"
        ;;
    nginx-survey)     # nginx-survey   (read-only: what nginx already serves)
        # Lines: "enabled NAME", "default_server NAME" (declares default_server),
        # and "stock_default yes|no" (is sites-enabled/default the untouched Debian page?).
        shopt -s nullglob
        for f in "${SITES_ENABLED}"/* /etc/nginx/conf.d/*.conf; do
            n=$(basename "$f")
            echo "enabled $n"
            grep -qE 'listen[^;]*default_server' "$f" 2>/dev/null && echo "default_server $n"
        done
        if [[ -e "${SITES_ENABLED}/default" ]] && grep -q 'root /var/www/html' "${SITES_ENABLED}/default" 2>/dev/null \
            && ! grep -q 'proxy_pass' "${SITES_ENABLED}/default" 2>/dev/null; then
            echo "stock_default yes"
        else
            echo "stock_default no"
        fi
        ;;
    update-start)     # update-start vX.Y.Z   (runs the update as a detached systemd job)
        check_release_tag "${1:-}"
        mkdir -p /var/log/docklite /var/lib/docklite; chmod 755 /var/log/docklite /var/lib/docklite
        if [[ -f "$UPDATE_STATE" ]]; then
            read -r st _t at _rest < "$UPDATE_STATE" || true
            if [[ "${st:-}" == running && "${at:-0}" =~ ^[0-9]+$ ]] && (( $(date +%s) - at < 2700 )); then
                die "an update is already running"
            fi
        fi
        set_update_state running "$1" "starting"
        : > "$UPDATE_LOG"; chmod 644 "$UPDATE_LOG"
        if command -v systemd-run >/dev/null 2>&1; then
            systemd-run --quiet --no-block --collect --unit "docklite-update-$(date +%s)" --setenv=TERM=dumb \
                /usr/local/sbin/docklite-helper update-job "$1" || die "could not start the update job"
        else
            TERM=dumb setsid nohup /usr/local/sbin/docklite-helper update-job "$1" >/dev/null 2>&1 </dev/null &
        fi
        ;;
    update-job)       # update-job vX.Y.Z   (internal: the detached worker; same validation)
        check_release_tag "${1:-}"
        # The install step replaces this very script. Run from a private copy so that can't disturb us.
        if [[ -z "${DOCKLITE_UPDATE_COPY:-}" ]]; then
            copy="$(mktemp /tmp/docklite-update-job.XXXXXX)"
            cp "$0" "$copy"
            DOCKLITE_UPDATE_COPY="$copy" exec bash "$copy" update-job "$1"
        fi
        run_update_job "$1"
        ;;
    fix-install-perms) # fix-install-perms   (make /opt/docklite usable by the docklite group again)
        [[ -d "$INSTALL_DIR" ]] || die "no DockLite install at $INSTALL_DIR"
        fix_install_perms
        ;;
    group-list)       # group-list   (members of the docklite group, one per line)
        getent group docklite | cut -d: -f4 | tr ',' '\n' | sed '/^$/d'
        ;;
    group-add)        # group-add USER   (admin shell access to DockLite)
        check_os_user "${1:-}"
        usermod -aG docklite "$1"
        ;;
    group-remove)     # group-remove USER
        check_os_user "${1:-}"
        gpasswd -d "$1" docklite
        ;;
    nginx-test)
        nginx -t
        ;;
    nginx-reload)
        nginx -t && nginx -s reload
        ;;
    nginx-restart)
        systemctl restart nginx
        ;;
    cert-issue)       # cert-issue DOMAIN [--www] [--email ADDRESS]
        domain="${1:-}"; shift || true
        check_domain "$domain"
        args=(--nginx -d "$domain" --non-interactive --agree-tos)
        email=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --www)   args+=(-d "www.${domain}"); shift ;;
                --email) check_email "${2:-}"; email="$2"; shift 2 ;;
                *)       die "unknown option: $1" ;;
            esac
        done
        if [[ -n "$email" ]]; then
            args+=(--email "$email")
        else
            args+=(--register-unsafely-without-email)
        fi
        certbot "${args[@]}"
        ;;
    cert-obtain)      # cert-obtain DOMAIN [--email ADDRESS]
        # Get a certificate without letting certbot edit nginx configs, so
        # DockLite can keep writing its own (certbot's edits would be lost
        # the next time DockLite rewrites the file). Renewals reload nginx.
        domain="${1:-}"; shift || true
        check_domain "$domain"
        args=(certonly --nginx -d "$domain" --non-interactive --agree-tos
              --keep-until-expiring --deploy-hook "systemctl reload nginx")
        email=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --email) check_email "${2:-}"; email="$2"; shift 2 ;;
                *)       die "unknown option: $1" ;;
            esac
        done
        if [[ -n "$email" ]]; then
            args+=(--email "$email")
        else
            args+=(--register-unsafely-without-email)
        fi
        certbot "${args[@]}"
        ;;
    cert-exists)      # cert-exists DOMAIN   (exit 0 if a certificate is installed)
        check_domain "${1:-}"
        [[ -f "${LE_LIVE}/$1/fullchain.pem" ]]
        ;;
    cert-renew)       # cert-renew DOMAIN
        check_domain "${1:-}"
        certbot renew --cert-name "$1" --force-renewal
        ;;
    cert-delete)      # cert-delete DOMAIN
        check_domain "${1:-}"
        certbot delete --cert-name "$1" --non-interactive
        ;;
    cert-list)
        ls "$LE_LIVE"
        ;;
    cert-read)        # cert-read NAME   (public certificate only, never the key)
        check_name "${1:-}"
        cat "${LE_LIVE}/$1/cert.pem"
        ;;
    *)
        die "usage: docklite-helper {site-write|site-enable|site-disable|site-remove|nginx-test|nginx-reload|nginx-restart|cert-issue|cert-obtain|cert-exists|cert-renew|cert-delete|cert-list|cert-read} ..."
        ;;
esac
