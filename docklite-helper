#!/usr/bin/env bash
# docklite-helper — the only command DockLite runs as root.
#
# Installed root-owned at /usr/local/sbin/docklite-helper and granted via
# /etc/sudoers.d/docklite. Every privileged action the agent or the launcher
# needs is a subcommand here with its arguments validated, instead of
# granting broad commands (tee, cat, nginx, openssl) whose arguments sudoers
# can't meaningfully restrict.
set -euo pipefail

SITES_AVAILABLE=/etc/nginx/sites-available
SITES_ENABLED=/etc/nginx/sites-enabled
LE_LIVE=/etc/letsencrypt/live

die() { echo "docklite-helper: $*" >&2; exit 1; }

# nginx config file names: no slashes, no leading dot.
check_name() {
    [[ "${1:-}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,252}$ ]] || die "invalid config name: ${1:-}"
}

# Plain DNS hostname (same shape the agent accepts).
check_domain() {
    [[ ${#1} -le 253 && "$1" =~ ^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)+$ ]] \
        || die "invalid domain: $1"
}

# A person's login account on this server: a plain name, an existing user,
# a real (non-system) uid, a real shell, and never docklite itself. Group
# changes are refused for anything else — root, service accounts, nobody.
check_os_user() {
    local name="${1:-}" entry uid shell min
    [[ "$name" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || die "invalid username: ${name}"
    [[ "$name" != "docklite" && "$name" != "root" ]] || die "refusing to change the ${name} account"
    entry=$(getent passwd "$name") || die "no such user on this server: ${name}"
    uid=$(cut -d: -f3 <<<"$entry")
    shell=$(cut -d: -f7 <<<"$entry")
    min=$(awk '/^UID_MIN/{print $2}' /etc/login.defs 2>/dev/null || true)
    [[ "${uid}" =~ ^[0-9]+$ && "${uid}" -ge "${min:-1000}" && "${uid}" -lt 65534 ]] || die "refusing to change a system account: ${name}"
    [[ "$shell" != */nologin && "$shell" != */false && -n "$shell" ]] || die "${name} has no login shell, so shell access would do nothing"
}

check_email() {
    [[ "$1" =~ ^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$ ]] || die "invalid email: $1"
}

cmd="${1:-}"
shift || true

case "$cmd" in
    site-write)       # site-write NAME  (config on stdin)
        check_name "${1:-}"
        tmp=$(mktemp "${SITES_AVAILABLE}/.docklite.XXXXXX")
        cat > "$tmp"
        chmod 644 "$tmp"
        mv -f "$tmp" "${SITES_AVAILABLE}/$1"
        ;;
    site-enable)      # site-enable NAME
        check_name "${1:-}"
        [[ -f "${SITES_AVAILABLE}/$1" ]] || die "no such site config: $1"
        ln -sfn "${SITES_AVAILABLE}/$1" "${SITES_ENABLED}/$1"
        ;;
    site-disable)     # site-disable NAME  (removes only the sites-enabled link)
        check_name "${1:-}"
        rm -f "${SITES_ENABLED}/$1"
        ;;
    site-remove)      # site-remove NAME   (removes enabled link and config)
        check_name "${1:-}"
        rm -f "${SITES_ENABLED}/$1" "${SITES_AVAILABLE}/$1"
        ;;
    nginx-survey)     # nginx-survey   (read-only: what nginx already serves)
        # Lines: "enabled NAME", "default_server NAME" (declares default_server),
        # and "stock_default yes|no" (is sites-enabled/default the untouched Debian page?).
        shopt -s nullglob
        for f in "${SITES_ENABLED}"/* /etc/nginx/conf.d/*.conf; do
            n=$(basename "$f")
            echo "enabled $n"
            grep -qE 'listen[^;]*default_server' "$f" 2>/dev/null && echo "default_server $n"
        done
        if [[ -e "${SITES_ENABLED}/default" ]] && grep -q 'root /var/www/html' "${SITES_ENABLED}/default" 2>/dev/null \
            && ! grep -q 'proxy_pass' "${SITES_ENABLED}/default" 2>/dev/null; then
            echo "stock_default yes"
        else
            echo "stock_default no"
        fi
        ;;
    group-list)       # group-list   (members of the docklite group, one per line)
        getent group docklite | cut -d: -f4 | tr ',' '\n' | sed '/^$/d'
        ;;
    group-add)        # group-add USER   (admin shell access to DockLite)
        check_os_user "${1:-}"
        usermod -aG docklite "$1"
        ;;
    group-remove)     # group-remove USER
        check_os_user "${1:-}"
        gpasswd -d "$1" docklite
        ;;
    nginx-test)
        nginx -t
        ;;
    nginx-reload)
        nginx -t && nginx -s reload
        ;;
    nginx-restart)
        systemctl restart nginx
        ;;
    cert-issue)       # cert-issue DOMAIN [--www] [--email ADDRESS]
        domain="${1:-}"; shift || true
        check_domain "$domain"
        args=(--nginx -d "$domain" --non-interactive --agree-tos)
        email=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --www)   args+=(-d "www.${domain}"); shift ;;
                --email) check_email "${2:-}"; email="$2"; shift 2 ;;
                *)       die "unknown option: $1" ;;
            esac
        done
        if [[ -n "$email" ]]; then
            args+=(--email "$email")
        else
            args+=(--register-unsafely-without-email)
        fi
        certbot "${args[@]}"
        ;;
    cert-obtain)      # cert-obtain DOMAIN [--email ADDRESS]
        # Get a certificate without letting certbot edit nginx configs, so
        # DockLite can keep writing its own (certbot's edits would be lost
        # the next time DockLite rewrites the file). Renewals reload nginx.
        domain="${1:-}"; shift || true
        check_domain "$domain"
        args=(certonly --nginx -d "$domain" --non-interactive --agree-tos
              --keep-until-expiring --deploy-hook "systemctl reload nginx")
        email=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --email) check_email "${2:-}"; email="$2"; shift 2 ;;
                *)       die "unknown option: $1" ;;
            esac
        done
        if [[ -n "$email" ]]; then
            args+=(--email "$email")
        else
            args+=(--register-unsafely-without-email)
        fi
        certbot "${args[@]}"
        ;;
    cert-exists)      # cert-exists DOMAIN   (exit 0 if a certificate is installed)
        check_domain "${1:-}"
        [[ -f "${LE_LIVE}/$1/fullchain.pem" ]]
        ;;
    cert-renew)       # cert-renew DOMAIN
        check_domain "${1:-}"
        certbot renew --cert-name "$1" --force-renewal
        ;;
    cert-delete)      # cert-delete DOMAIN
        check_domain "${1:-}"
        certbot delete --cert-name "$1" --non-interactive
        ;;
    cert-list)
        ls "$LE_LIVE"
        ;;
    cert-read)        # cert-read NAME   (public certificate only, never the key)
        check_name "${1:-}"
        cat "${LE_LIVE}/$1/cert.pem"
        ;;
    *)
        die "usage: docklite-helper {site-write|site-enable|site-disable|site-remove|nginx-test|nginx-reload|nginx-restart|cert-issue|cert-obtain|cert-exists|cert-renew|cert-delete|cert-list|cert-read} ..."
        ;;
esac
